new file mode 100644
index 00000000..4ac2ebe8
--- /dev/null
+++ b/src/core/psxrecomp_debug_server.h
@@ -0,0 +1,68 @@
+// PSXRecomp TCP debug server for DuckStation
+// JSON-over-newline protocol on localhost:4371
+// Same protocol as the PSXRecomp runner debug server.
+// Includes 36000-frame ring buffer for retroactive state queries.
+
+#pragma once
+
+#include "common/types.h"
+
+namespace PSXRecompDebug {
+
+bool Initialize(u16 port = 4371);
+void Shutdown();
+bool HasAnyClients();
+
+/// Call once per frame from System::FrameDone(). Records frame state into
+/// the ring buffer, checks watchpoints, handles step-N logic.
+void OnFrameDone();
+
+/// Fold one guest write into the per-frame fingerprint. Called from the
+/// interpreter's store path in cpu_core.cpp.
+///
+/// This mirrors fp_record_write() in psxrecomp's debug_server.c byte for byte,
+/// including the FNV-1a constants and the decision to keep main RAM,
+/// scratchpad, and MMIO in SEPARATE hashes -- folding device-register churn
+/// into the RAM signal is what previously hid a real first divergence, because
+/// the RAM hash only ever sees the AFTERMATH of a device-interaction fork.
+///
+/// The two emulators must agree exactly or `frame_fingerprint` compares
+/// nothing. Do not "improve" the hash on one side.
+void RecordWrite(u32 addr, u32 value, u32 pc);
+
+/// True when a client has armed fingerprinting. The store hook checks this
+/// first so an unattached oracle pays almost nothing.
+bool FingerprintArmed();
+
+/// Record one CDROM command as it begins execution (called from
+/// CDROM::ExecuteCommand). Mirrors psx-runtime's cdrom_command_history so
+/// the two emulators' command streams can be diffed directly -- the
+/// measurement that localises a game-side request divergence like Legend of
+/// Mana's land-creation palette load (native requests sector 125113 where
+/// the oracle requests 125112; every layer below the game measures clean).
+void RecordCdCommand(u8 command, const u8* params, u32 param_count);
+
+/// Record one channel-3 DMA into RAM (called from DMA::TransferMemoryBlock).
+/// Mirrors psx-runtime's cd_read_log so the two slot maps can be diffed.
+void RecordCdDma(u32 dest, u32 size_bytes, s32 lba, const void* data);
+
+/// Per-sector notification accounting, mirroring psx-runtime's per-sector
+/// delivery records ([D]ata / [P]ended / [L]ost). psx-runtime delivers an
+/// immediate INT1 for a sector arriving with the flag clear; DuckStation may
+/// instead DROP it and re-announce after the guest drains. Which of those
+/// happens to the sectors the guest misses is the open question.
+enum : u8
+{
+  CDSE_DATA = 1,        // sector stored in a buffer
+  CDSE_DROPPED = 2,     // INT1 not raised: one was already unacknowledged
+  CDSE_QUEUED = 4,      // INT1 became the pending async interrupt
+  CDSE_DELIVERED = 8,   // INT1 actually presented to the guest
+  CDSE_REDELIVERED = 16,// re-announced by the missed-sector path
+  CDSE_DRAINED = 32,    // guest read the buffer to completion
+};
+void RecordCdSector(s32 lba, u32 buffer);
+void FlagCdSector(u32 buffer, u8 bits);
+void FlagCdSectorDelivered(u32 buffer);
+void FlagCdSectorDrained();
+
+} // namespace PSXRecompDebug
