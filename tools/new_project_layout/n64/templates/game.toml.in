# game.toml — the per-game contract for @NAME@.
#
# Section set follows n64lle docs/05-PROPOSAL.md §10 ("game.toml sections (N64)").
#
# STATUS: this file is the DECLARED contract, and it is HAND-MAINTAINED. No
# program in this project writes it — that is what keeps the provenance tags
# below trustworthy. The user's own settings live in settings.toml beside the
# executable, which the launcher writes and which OVERRIDES this file:
#
#     environment > command line > settings.toml > game.toml > built-in
#
# n64lle ships no game.toml loader for the BUILD yet, so the build keys here are
# mirrored as CMake cache variables in CMakeLists.txt and each mirror is marked
# there. The RUNTIME keys are really read: n64lle runtime/host/host_config.c
# parses the [game], [runtime] and [controller] sections at startup, and
# `@EXE@ --check-config` is registered as a ctest that fails this build if any
# of it stops resolving. Keys the host reads are tagged [HOST].
#
# Provenance tags:
#   [MEASURED] read off this ROM by tools/new_project/probe_rom.py on @DATE@
#   [DECLARED] a project decision, not yet enforced by anything
#   [UNKNOWN]  honestly not established — do not treat as fact

[game]
name       = "@NAME@"
cartid     = "@CARTID@"                # header 0x3B..0x3E                [MEASURED]
region     = "@REGION@"                # header 0x3E — @REGION_LABEL@     [MEASURED]
revision   = @REVISION@                # header 0x3F                      [MEASURED]
entry_pc   = "@ENTRY_PC@"              # header 0x08                      [MEASURED]
rom_size   = @ROM_SIZE@                # @ROM_SIZE_H@                     [MEASURED]
byte_order = "@BYTE_ORDER@"            # from the header magic            [MEASURED]

# CIC. n64_cic_detect() resolves this from the IPL2 checksum over ROM
# [0x40,0x1000); it is NOT read from this file. Recorded so a mismatch is
# visible rather than silent — the scaffolder cross-checked the value below
# against the harvester's own detector before writing it.
cic        = "@CIC@"                   #                                  [MEASURED]
cic_seed   = "@CIC_SEED@"              #                                  [MEASURED]
cic_challenge = "@CIC_CHALLENGE@"      # "real" only on CIC-6105          [MEASURED]

# ROM identity. The build acts only on a ROM matching these, and the launcher
# verifies a player's copy against the sha256.
crc1       = "@CRC1@"                  # header 0x10                      [MEASURED]
crc2       = "@CRC2@"                  # header 0x14                      [MEASURED]
sha256     = "@SHA256@"  # [MEASURED]

# Save backing. n64lle models NO save device today: si.c states "We model no
# EEPROM and no RTC", and pi.c's save database carries no EEPROM rows at all.
# Establishing what this cart actually uses is a measurement nobody has made
# here, so it stays UNKNOWN rather than becoming a guess — and the launcher
# hides its SAVES panel entirely rather than offering controls that cannot work.
save_type  = "unknown"                 #                                  [UNKNOWN]
save_size  = 0                         #                                  [UNKNOWN]

[recompiler]
# Discovery is execution-derived (n64lle docs/05 §12 M1): the harvester runs the
# real boot on the interpreter and records what executed. No seed files, no
# symbol map, no decomp required.
seeds       = []                       #                                  [DECLARED]
out_dir     = "generated"
strict      = true
# Harvest window. Mirrored into CMake as @SLUG_UPPER@_HARVEST_FRAMES /
# _STEP_CAP_M. Widen it if the title's early execution is not covered.
harvest_frames         = @HARVEST_FRAMES@
harvest_step_cap_millions = @HARVEST_STEP_CAP_M@
harvest_rsp_execution  = true          # N64_RSP_EXEC=1 — without it no graphics
                                       # task ever runs and the harvest silently
                                       # under-covers                    [DECLARED]
# TLB assertion (§10). NOT established for this title — do not assert "unused"
# on a hunch; an unproven assertion is worse than an absent one.
tlb         = "unknown"                #                                  [UNKNOWN]

[runtime]
window_title = "@WINDOW_TITLE@"        #                             [DECLARED][HOST]
save_dir     = "saves"                 #                             [DECLARED][HOST]
pak_dir      = "paks"                  #                             [DECLARED][HOST]
hle_tier     = false                   # LLE-first; no HLE tier is enabled [DECLARED]
debug_port   = 0                       # ephemeral — fixed localhost ports
                                       # collide with sibling recomp projects
# RSP execution. n64_devices_set_rsp_execution() defaults OFF in the device
# model, and with it off no graphics task ever runs and every frame is blank —
# so a host whose job is to show the game must turn it on. N64_RSP_EXEC in the
# environment still overrides this.                             [DECLARED][HOST]
rsp_execution = true
# Exe-anchored dump path the host tries before it asks. In a build tree the
# runtime target links roms/ beside the executable, so this resolves to the very
# dump the recompilation was harvested from — a developer convenience, nothing
# more. A packaged build has no such file and falls through to the launcher's
# picker, which is correct there.                               [DECLARED][HOST]
rom_hint = "@ROM_FILE@"

[video]
renderer     = "lle-sw"                # the software rasterizer; lle-compute is
                                       # not built                        [DECLARED]
aspect_ratio = "4:3"                   # the VI scanout is 640x480; the launcher
                                       # is told 4:3 is the ONLY aspect, because
                                       # a widescreen cycle would change nothing
                                       #                                  [DECLARED]

[rsp]
ucode_cache = "off"                    #                                  [DECLARED]

[controller]
# How many ports get a device is DECLARED here and is what the launcher shows as
# its player count. n64lle models a standard pad with no pak; `pak` is
# declarative only, because no controller pak, Transfer Pak or rumble is
# modeled — "none" is the only honest value.
#
# The BUTTON BINDINGS are deliberately not here. They live in input.cfg beside
# the executable, in the N64 runners' own `<dev>.<INPUT>.<idx>=<field>` format,
# which recomp-ui's Configure page reads and writes and the host reads back
# through the same bridge. One format, one file.            [DECLARED][HOST]
port1 = { device = "gamepad", pak = "none" }
port2 = { device = "@PORT2@" }
port3 = { device = "@PORT3@" }
port4 = { device = "@PORT4@" }
bind_file = "input.cfg"                # relative to the executable  [DECLARED][HOST]

[cosim]
# Lockstep co-simulation of the compiled tier against the interpreter floor,
# using n64lle's ROM-agnostic bench/cosim_gate1_driver.c. Gates in CMakeLists.txt.
fixture = "@SLUG@-cosim"
legs    = ["default", "rsp"]

[audit]
# Generated-code audit regions. Populated by triaging the dispatch-miss leaders
# the host reports at the end of every run — project law puts that ahead of all
# other debugging.
regions = []                           #                                  [UNKNOWN]

[enhancements]
# n64lle ENHANCEMENTS Rule 1: enhancements off => byte-identical build.
# None are defined. Correctness first.
