# Generated recompiler output — derived from a copyrighted ROM. Never commit.
/src/gen/
/recomp/funcs.h

# The ROM itself, in every form. Players supply their own.
*.sfc
*.smc
*.srm

# Build trees and packaged output
/build/
/build-*/
/dist/
/saves/

# Diagnostic capture bundles (tools/snes_analysis: snes_frame_capture.py,
# snes_asset_decode.py, snes_loop_compare.py). These embed VRAM/CGRAM/WRAM
# dumps taken from a running game — data derived from the ROM, for the same
# reason /src/gen/ is never committed. They are evidence, not source:
# regenerate them locally.
/analysis/

# Local probe output that names paths on one machine
/rom_probe.json

.DS_Store
